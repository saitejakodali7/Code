            Next
            html.AppendLine("</style></head><body><main><header class='intro'><div class='eyebrow'>Offline metadata review</div><h1>Initial hierarchy clone preview</h1>")
            html.AppendLine("<p>Compare the original branch with the proposed clone under its destination. Select a dimension view, then expand or collapse any triangle.</p>")
