                New Double() {26, 32, 36, 22, 32, 18, 20, 18, 45, 9, 9, 80, 80, 20})
            For Each dimNode As XElement In targetDims
                For Each newMember As XElement In dimNode.Element("members").Elements("member")
                    Dim targetName As String = Attr(newMember, "name")
                    Dim oldName As String = inverse(targetName)
                    Dim oldMember As XElement = sourceMembers(oldName)
                    Add(memberSheet, oldName, targetName, Attr(dimNode, "name"), Preview(Attr(newMember, "description")),
                        MemberProperty(newMember, "AccountType"), MemberProperty(newMember, "FormulaType"),
                        MemberProperty(newMember, "AllowInput"), MemberProperty(newMember, "IsConsolidated"),
                        Preview(Aliases(oldMember)), Preview(Aliases(newMember)), issueRefs(oldName))
