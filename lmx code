        End Function

        Private Shared Function MakeSheet(ByVal name As String, ByVal title As String, ByVal note As String,
            ByVal headers As Object(), ByVal widths As Double()) As ReviewSheet
            Dim sheet As New ReviewSheet With {.Name = name, .Widths = widths, .HeaderRow = 4, .FreezeRows = 4,
                .FreezeColumns = If(name = "Overview" OrElse name = "Review", 0, 2)}
            sheet.Rows.Add(New Object() {title})
            sheet.Rows.Add(New Object() {note})
            sheet.Rows.Add(New Object() {})
            sheet.Rows.Add(headers)
            Return sheet
        End Function

        Private Shared Sub Add(ByVal sheet As ReviewSheet, ParamArray values As Object())
            If sheet.Rows.Count >= 1000000 Then Throw New InvalidOperationException("Excel review sheet exceeds its row limit: " & sheet.Name)
            sheet.Rows.Add(values)
        End Sub

        Private Shared Sub AddChildren(ByVal sheet As ReviewSheet, ByVal oldParent As String, ByVal newParent As String,
            ByVal depth As Integer, ByVal children As Dictionary(Of String, List(Of XElement)),
            ByVal owners As Dictionary(Of XElement, String), ByVal mapping As Dictionary(Of String, String),
            ByVal issues As Dictionary(Of String, String))
            If depth > 500 Then Throw New InvalidOperationException("Hierarchy exceeds 500 levels.")
            If Not children.ContainsKey(oldParent) Then Return
            For Each edge As XElement In children(oldParent)
                If sheet.Rows.Count >= 200000 Then Throw New InvalidOperationException("Hierarchy path expansion exceeds 200,000 rows. Inspect the Relationships sheet model instead.")
                Dim oldChild As String = Attr(edge, "child")
                Dim newChild As String = If(mapping.ContainsKey(oldChild), mapping(oldChild), oldChild)
                Add(sheet, depth, oldChild, New String(" "c, depth * 2) & newChild, oldParent, newParent,
                    If(mapping.ContainsKey(oldChild), "New parent", "Reuse existing account"), owners(edge), Weight(edge), issues(oldChild))
                AddChildren(sheet, oldChild, newChild, depth + 1, children, owners, mapping, issues)
            Next
        End Sub

        Private Shared Sub AddMemberProperties(ByVal sheet As ReviewSheet, ByVal dimName As String,
            ByVal oldName As String, ByVal newName As String, ByVal oldMember As XElement, ByVal newMember As XElement, ByVal issueIds As String)
            For Each name As XName In oldMember.Attributes().Select(Function(a) a.Name).Union(newMember.Attributes().Select(Function(a) a.Name))
                PropertyParts(sheet, dimName, oldName, newName, "Member attribute", name.LocalName, "", "", "", "",
                    CStr(oldMember.Attribute(name)), CStr(newMember.Attribute(name)), issueIds)
            Next
            Dim oldProperties = oldMember.Elements("properties").Elements().ToList()
            Dim newProperties = newMember.Elements("properties").Elements().ToList()
            If oldProperties.Count <> newProperties.Count Then Throw New InvalidOperationException("Property alignment changed for " & oldName)
            For i As Integer = 0 To oldProperties.Count - 1
                Dim a As XElement = oldProperties(i), b As XElement = newProperties(i)
                Dim other As String = String.Join("; ", a.Attributes().Where(Function(x) Not {"name", "value", "cubeType", "scenarioType", "time"}.
                    Contains(x.Name.LocalName, CI)).Select(Function(x) x.ToString()).ToArray())
                PropertyParts(sheet, dimName, oldName, newName, "Member property", Attr(a, "name"), Attr(a, "cubeType"),
                    Attr(a, "scenarioType"), Attr(a, "time"), other,
                    If(a.Attribute("value") Is Nothing, a.ToString(SaveOptions.DisableFormatting), Attr(a, "value")),
                    If(b.Attribute("value") Is Nothing, b.ToString(SaveOptions.DisableFormatting), Attr(b, "value")), issueIds)
            Next
            Dim oldSections = oldMember.Elements().Where(Function(e) e.Name.LocalName <> "properties").ToList()
            Dim newSections = newMember.Elements().Where(Function(e) e.Name.LocalName <> "properties").ToList()
            If oldSections.Count <> newSections.Count Then Throw New InvalidOperationException("Member section alignment changed for " & oldName)
            For i As Integer = 0 To oldSections.Count - 1
                PropertyParts(sheet, dimName, oldName, newName, "Member section", oldSections(i).Name.LocalName,
                    "", "", "", "", oldSections(i).ToString(SaveOptions.DisableFormatting),
                    newSections(i).ToString(SaveOptions.DisableFormatting), issueIds)
            Next
        End Sub

        Private Shared Sub AddSectionProperties(ByVal sheet As ReviewSheet, ByVal dimName As String,
            ByVal oldName As String, ByVal newName As String, ByVal kind As String,
            ByVal oldNode As XElement, ByVal newNode As XElement, ByVal issueIds As String)
            If oldNode Is Nothing Then Return
            PropertyParts(sheet, dimName, oldName, newName, kind, "Full relationship XML", "", "", "", "",
                oldNode.ToString(SaveOptions.DisableFormatting), newNode.ToString(SaveOptions.DisableFormatting), issueIds)
        End Sub

        Private Shared Sub PropertyParts(ByVal sheet As ReviewSheet, ByVal dimName As String, ByVal oldName As String,
            ByVal newName As String, ByVal kind As String, ByVal propertyName As String, ByVal cube As String,
            ByVal scenario As String, ByVal time As String, ByVal context As String, ByVal oldValue As String,
            ByVal newValue As String, ByVal issueIds As String)
            Dim a = SplitText(If(oldValue, "")), b = SplitText(If(newValue, ""))
            Dim count As Integer = Math.Max(a.Count, b.Count)
            For i As Integer = 0 To count - 1
                Add(sheet, dimName, oldName, newName, kind, propertyName, cube, scenario, time, context,
                    i + 1, count, If(i < a.Count, a(i), ""), If(i < b.Count, b(i), ""), issueIds)
            Next
        End Sub

        Private Shared Function SplitText(ByVal value As String) As List(Of String)
            Dim parts As New List(Of String)
            Dim offset As Integer = 0
            While offset < value.Length
                Dim length As Integer = Math.Min(32000, value.Length - offset)
                If offset + length < value.Length AndAlso Char.IsHighSurrogate(value(offset + length - 1)) Then length -= 1
                parts.Add(value.Substring(offset, length))
                offset += length
            End While
            If parts.Count = 0 Then parts.Add("")
            Return parts
        End Function

        Private Shared Function Preview(ByVal value As String) As String
            If value.Length <= 1000 Then Return value
            Dim length As Integer = 1000
            If Char.IsHighSurrogate(value(length - 1)) Then length -= 1
            Return value.Substring(0, length) & " ... [full value in Properties]"
        End Function

        Private Shared Function Attr(ByVal node As XElement, ByVal name As String) As String
            Return If(node Is Nothing, "", If(CStr(node.Attribute(name)), ""))
        End Function

        Private Shared Function MemberProperty(ByVal member As XElement, ByVal name As String) As String
            Dim p = member.Descendants("property").FirstOrDefault(Function(x) CI.Equals(Attr(x, "name"), name))
            Return If(p Is Nothing, "Not explicitly set", Attr(p, "value"))
        End Function

        Private Shared Function Aliases(ByVal member As XElement) As String
            Dim values As New List(Of String)
            For Each a As XAttribute In member.Attributes().Where(Function(x) CI.Equals(x.Name.LocalName, "Alias") OrElse CI.Equals(x.Name.LocalName, "Aliases"))
                values.Add(a.Value)
            Next
            For Each p As XElement In member.Descendants("property").Where(Function(x) CI.Equals(Attr(x, "name"), "Alias") OrElse CI.Equals(Attr(x, "name"), "Aliases"))
                values.Add(Attr(p, "value"))
            Next
            Return String.Join(", ", values.Where(Function(v) v.Length > 0).ToArray())
        End Function

        Private Shared Function Weight(ByVal edge As XElement) As Object
            Dim text As String = Attr(edge, "aggregationWeight")
            If text.Length = 0 Then Return "Not explicitly set"
            Dim value As Decimal
            If Decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, value) Then Return value
            Return text
        End Function

        Private Shared Function Key(ByVal dimName As String, ByVal parent As String, ByVal child As String) As String
            Return dimName & ChrW(0) & parent & ChrW(0) & child
        End Function
    End Class
End Namespace


Namespace OneStream.BusinessRule.Extender.BuildMMRptgClone
    ' A static review snapshot. It does not read spreadsheet edits or update the XML package.
    Public Class ReviewSheet
        Public Name As String
        Public Rows As New List(Of Object())
        Public Widths As Double()
        Public FreezeRows As Integer
        Public FreezeColumns As Integer
        Public HeaderRow As Integer
    End Class

    Public Class ReviewWorkbookWriter
        Private Shared ReadOnly MainNs As XNamespace = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
        Private Shared ReadOnly RelNs As XNamespace = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
        Private Shared ReadOnly PackageNs As XNamespace = "http://schemas.openxmlformats.org/package/2006/relationships"
        Private Shared ReadOnly TypesNs As XNamespace = "http://schemas.openxmlformats.org/package/2006/content-types"

        Public Shared Sub Save(ByVal path As String, ByVal sheets As List(Of ReviewSheet))
            If String.IsNullOrWhiteSpace(path) Then Throw New ArgumentException("Workbook output path is required.")
            If sheets Is Nothing OrElse sheets.Count = 0 Then Throw New ArgumentException("At least one review sheet is required.")
            Dim names As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each sheet As ReviewSheet In sheets
                ValidateSheet(sheet)
                If Not names.Add(sheet.Name) Then Throw New ArgumentException("Duplicate worksheet name: " & sheet.Name)
            Next
            ' CreateNew avoids replacing an existing user file. Failed builds should be discarded.
            Dim created As Boolean = False
            Try
                Using stream As New FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None)
                    created = True
                    Using zip As New System.IO.Compression.ZipArchive(stream, System.IO.Compression.ZipArchiveMode.Create, False)
                        Put(zip, "[Content_Types].xml", ContentTypes(sheets.Count))
                        Put(zip, "_rels/.rels", New XDocument(New XElement(PackageNs + "Relationships",
                            New XElement(PackageNs + "Relationship", New XAttribute("Id", "rId1"), New XAttribute("Type", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument"), New XAttribute("Target", "xl/workbook.xml")))))
                        Put(zip, "xl/workbook.xml", Workbook(sheets))
                        Put(zip, "xl/_rels/workbook.xml.rels", WorkbookRelationships(sheets.Count))
                        Put(zip, "xl/styles.xml", Styles())
                        For i As Integer = 0 To sheets.Count - 1
                            Put(zip, "xl/worksheets/sheet" & (i + 1).ToString(CultureInfo.InvariantCulture) & ".xml", Worksheet(sheets(i)))
                        Next
                    End Using
                End Using
            Catch ex As Exception
                If created Then
                    Try
                        File.Delete(path)
                    Catch
                        ' Preserve the original failure, including the output path.
                    End Try
                End If
                Throw New InvalidOperationException("Could not write review workbook '" & path & "': " & ex.Message, ex)
            End Try
        End Sub

        Private Shared Sub ValidateSheet(ByVal sheet As ReviewSheet)
            If sheet Is Nothing OrElse String.IsNullOrWhiteSpace(sheet.Name) Then Throw New ArgumentException("Worksheet name is required.")
            CheckText(sheet.Name, "Worksheet name")
            If sheet.Name.Length > 31 OrElse sheet.Name.IndexOfAny(New Char() {":"c, ChrW(92), "/"c, "?"c, "*"c, "["c, "]"c}) >= 0 OrElse sheet.Name.StartsWith("'", StringComparison.Ordinal) OrElse sheet.Name.EndsWith("'", StringComparison.Ordinal) Then
                Throw New ArgumentException("Invalid Excel worksheet name: " & sheet.Name)
            End If
            If sheet.Rows Is Nothing OrElse sheet.Rows.Count > 1048576 Then Throw New ArgumentException("Invalid row count on " & sheet.Name)
            If sheet.FreezeRows < 0 OrElse sheet.FreezeRows >= 1048576 Then Throw New ArgumentException("Invalid freeze row count on " & sheet.Name)
            If sheet.FreezeColumns < 0 OrElse sheet.FreezeColumns >= 16384 Then Throw New ArgumentException("Invalid freeze column count on " & sheet.Name)
            If sheet.HeaderRow < 0 OrElse sheet.HeaderRow > sheet.Rows.Count Then Throw New ArgumentException("Invalid header row on " & sheet.Name)
            If sheet.Widths IsNot Nothing Then
                If sheet.Widths.Length > 16384 Then Throw New ArgumentException("Too many column widths on " & sheet.Name)
                For Each width As Double In sheet.Widths
                    If Double.IsNaN(width) OrElse Double.IsInfinity(width) OrElse width <= 0 OrElse width > 255 Then Throw New ArgumentException("Invalid column width on " & sheet.Name)
                Next
            End If
            For r As Integer = 0 To sheet.Rows.Count - 1
                Dim row As Object() = sheet.Rows(r)
                If row Is Nothing Then Continue For
                If row.Length > 16384 Then Throw New ArgumentException("Too many columns in " & sheet.Name & " row " & (r + 1).ToString())
                For c As Integer = 0 To row.Length - 1
                    Dim item As Object = row(c)
                    If item Is Nothing OrElse Convert.IsDBNull(item) OrElse IsNumericValue(item) Then Continue For
                    CheckText(Convert.ToString(item, CultureInfo.InvariantCulture), "Cell " & sheet.Name & "!" & ColumnName(c + 1) & (r + 1).ToString())
                Next
            Next
        End Sub

        Private Shared Sub CheckText(ByVal value As String, ByVal label As String)
            If value Is Nothing Then Return
            If value.Length > 32767 Then Throw New ArgumentException(label & " exceeds Excel's 32,767-character cell limit; split it before writing.")
            Try
                XmlConvert.VerifyXmlChars(value)
            Catch ex As Exception
                Throw New ArgumentException(label & " contains characters not permitted in XML 1.0.", ex)
            End Try
        End Sub

        Private Shared Function IsNumericValue(ByVal value As Object) As Boolean
            Return TypeOf value Is Byte OrElse TypeOf value Is SByte OrElse TypeOf value Is Short OrElse
                   TypeOf value Is UShort OrElse TypeOf value Is Integer OrElse TypeOf value Is UInteger OrElse
                   TypeOf value Is Long OrElse TypeOf value Is ULong OrElse TypeOf value Is Single OrElse
                   TypeOf value Is Double OrElse TypeOf value Is Decimal
        End Function

        Private Shared Function Cell(ByVal value As Object, ByVal address As String, ByVal style As Integer) As XElement
            If value IsNot Nothing AndAlso Not Convert.IsDBNull(value) AndAlso Not IsNumericValue(value) Then
                If style = 0 Then style = 5
                If style = 4 Then style = 6
            End If
            Dim cellNode As New XElement(MainNs + "c", New XAttribute("r", address), New XAttribute("s", style))
            If value Is Nothing OrElse Convert.IsDBNull(value) Then Return cellNode
            If IsNumericValue(value) Then
                If (TypeOf value Is Double AndAlso (Double.IsNaN(CDbl(value)) OrElse Double.IsInfinity(CDbl(value)))) OrElse
                   (TypeOf value Is Single AndAlso (Single.IsNaN(CSng(value)) OrElse Single.IsInfinity(CSng(value)))) Then
                    Throw New ArgumentException("Non-finite numeric value at " & address)
                End If
                cellNode.Add(New XElement(MainNs + "v", Convert.ToString(value, CultureInfo.InvariantCulture)))
            Else
                Dim s As String = Convert.ToString(value, CultureInfo.InvariantCulture)
                CheckText(s, "Cell " & address)
                cellNode.Add(New XAttribute("t", "inlineStr"), New XElement(MainNs + "is", New XElement(MainNs + "t", New XAttribute(XNamespace.Xml + "space", "preserve"), s)))
            End If
            Return cellNode
        End Function

        Private Shared Function ColumnName(ByVal number As Integer) As String
            Dim result As String = ""
            While number > 0
                number -= 1
                result = ChrW(65 + (number Mod 26)) & result
                number = number \ 26
            End While
            Return result
        End Function

        Private Shared Function Worksheet(ByVal sheet As ReviewSheet) As XDocument
            Dim cols As Integer = 1
            For Each row As Object() In sheet.Rows
                If row IsNot Nothing Then cols = Math.Max(cols, row.Length)
            Next
            Dim data As New XElement(MainNs + "sheetData")
            For r As Integer = 0 To sheet.Rows.Count - 1
                Dim values As Object() = sheet.Rows(r)
                Dim row As New XElement(MainNs + "row", New XAttribute("r", r + 1),
                    New XAttribute("ht", RowHeight(sheet, values, r, cols).ToString(CultureInfo.InvariantCulture)),
                    New XAttribute("customHeight", "1"))
                Dim style As Integer = If(r = 0, 1, If(r = 1, 2, If(r + 1 = sheet.HeaderRow, 3, If((r Mod 2) = 0, 4, 0))))
                For c As Integer = 0 To cols - 1
                    Dim value As Object = If(values IsNot Nothing AndAlso c < values.Length, values(c), Nothing)
                    row.Add(Cell(value, ColumnName(c + 1) & (r + 1).ToString(CultureInfo.InvariantCulture), style))
                Next
                data.Add(row)
            Next
            Dim root As New XElement(MainNs + "worksheet")
            Dim view As New XElement(MainNs + "sheetView", New XAttribute("workbookViewId", "0"), New XAttribute("showGridLines", "0"))
            If sheet.FreezeRows > 0 OrElse sheet.FreezeColumns > 0 Then
                Dim topLeft As String = ColumnName(sheet.FreezeColumns + 1) & (sheet.FreezeRows + 1).ToString()
                Dim activePane As String = If(sheet.FreezeRows > 0, If(sheet.FreezeColumns > 0, "bottomRight", "bottomLeft"), "topRight")
                Dim pane As New XElement(MainNs + "pane", New XAttribute("topLeftCell", topLeft), New XAttribute("activePane", activePane), New XAttribute("state", "frozen"))
                If sheet.FreezeColumns > 0 Then pane.Add(New XAttribute("xSplit", sheet.FreezeColumns))
                If sheet.FreezeRows > 0 Then pane.Add(New XAttribute("ySplit", sheet.FreezeRows))
                view.Add(pane, New XElement(MainNs + "selection", New XAttribute("pane", activePane), New XAttribute("activeCell", topLeft), New XAttribute("sqref", topLeft)))
            End If
            root.Add(New XElement(MainNs + "sheetViews", view))
            Dim columns As New XElement(MainNs + "cols")
            For c As Integer = 0 To cols - 1
                Dim width As Double = If(sheet.Widths IsNot Nothing AndAlso c < sheet.Widths.Length, sheet.Widths(c), 22.0R)
                columns.Add(New XElement(MainNs + "col", New XAttribute("min", c + 1), New XAttribute("max", c + 1), New XAttribute("width", width.ToString(CultureInfo.InvariantCulture)), New XAttribute("customWidth", "1")))
            Next
            root.Add(columns, data)
            If sheet.HeaderRow > 0 AndAlso sheet.Rows.Count >= sheet.HeaderRow Then
                root.Add(New XElement(MainNs + "autoFilter", New XAttribute("ref", "A" & sheet.HeaderRow.ToString() & ":" & ColumnName(cols) & sheet.Rows.Count.ToString())))
            End If
            If cols > 1 AndAlso sheet.Rows.Count > 0 Then
                Dim merges As New XElement(MainNs + "mergeCells")
                If CanMerge(sheet.Rows(0)) Then merges.Add(New XElement(MainNs + "mergeCell", New XAttribute("ref", "A1:" & ColumnName(cols) & "1")))
                If sheet.Rows.Count > 1 AndAlso CanMerge(sheet.Rows(1)) Then merges.Add(New XElement(MainNs + "mergeCell", New XAttribute("ref", "A2:" & ColumnName(cols) & "2")))
                If merges.HasElements Then
                    merges.SetAttributeValue("count", merges.Elements().Count())
                    root.Add(merges)
                End If
            End If
            Return New XDocument(New XDeclaration("1.0", "utf-8", "yes"), root)
        End Function

        Private Shared Function CanMerge(ByVal values As Object()) As Boolean
            If values Is Nothing Then Return True
            For c As Integer = 1 To values.Length - 1
                If values(c) IsNot Nothing AndAlso Not Convert.IsDBNull(values(c)) AndAlso
                   Convert.ToString(values(c), CultureInfo.InvariantCulture).Length > 0 Then Return False
            Next
            Return True
        End Function

        Private Shared Function RowHeight(ByVal sheet As ReviewSheet, ByVal values As Object(), ByVal rowIndex As Integer, ByVal columnCount As Integer) As Double
            If rowIndex = 0 Then Return 30.0R
            If rowIndex = 1 Then Return 42.0R
            If rowIndex + 1 = sheet.HeaderRow Then Return 36.0R
            If values Is Nothing OrElse values.Length = 0 Then Return 20.0R
            Dim maxLines As Integer = 1
            For c As Integer = 0 To Math.Min(values.Length, columnCount) - 1
                If values(c) Is Nothing OrElse Convert.IsDBNull(values(c)) Then Continue For
                Dim value As String = Convert.ToString(values(c), CultureInfo.InvariantCulture)
                Dim width As Double = If(sheet.Widths IsNot Nothing AndAlso c < sheet.Widths.Length, sheet.Widths(c), 22.0R)
                Dim charsPerLine As Integer = Math.Max(1, CInt(Math.Floor(width * 0.9R)))
                Dim lines As Integer = 0
                For Each segment As String In value.Split(ChrW(10))
                    lines += Math.Max(1, CInt(Math.Ceiling(CDbl(segment.Length) / charsPerLine)))
                    If lines >= 8 Then Exit For
                Next
                maxLines = Math.Max(maxLines, Math.Min(lines, 8))
            Next
            Return Math.Min(120.0R, Math.Max(20.0R, maxLines * 15.0R + 4.0R))
        End Function

        Private Shared Function Workbook(ByVal sheets As List(Of ReviewSheet)) As XDocument
            Dim container As New XElement(MainNs + "sheets")
            For i As Integer = 0 To sheets.Count - 1
                container.Add(New XElement(MainNs + "sheet", New XAttribute("name", sheets(i).Name), New XAttribute("sheetId", i + 1), New XAttribute(RelNs + "id", "rId" & (i + 1).ToString())))
            Next
            Return New XDocument(New XDeclaration("1.0", "utf-8", "yes"), New XElement(MainNs + "workbook", New XAttribute(XNamespace.Xmlns + "r", RelNs.NamespaceName), New XElement(MainNs + "bookViews", New XElement(MainNs + "workbookView")), container))
        End Function

        Private Shared Function WorkbookRelationships(ByVal count As Integer) As XDocument
            Dim root As New XElement(PackageNs + "Relationships")
            For i As Integer = 1 To count
                root.Add(New XElement(PackageNs + "Relationship", New XAttribute("Id", "rId" & i.ToString()), New XAttribute("Type", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet"), New XAttribute("Target", "worksheets/sheet" & i.ToString() & ".xml")))
            Next
            root.Add(New XElement(PackageNs + "Relationship", New XAttribute("Id", "rId" & (count + 1).ToString()), New XAttribute("Type", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles"), New XAttribute("Target", "styles.xml")))
            Return New XDocument(New XDeclaration("1.0", "utf-8", "yes"), root)
        End Function

        Private Shared Function ContentTypes(ByVal count As Integer) As XDocument
            Dim root As New XElement(TypesNs + "Types",
                New XElement(TypesNs + "Default", New XAttribute("Extension", "rels"), New XAttribute("ContentType", "application/vnd.openxmlformats-package.relationships+xml")),
                New XElement(TypesNs + "Default", New XAttribute("Extension", "xml"), New XAttribute("ContentType", "application/xml")),
                New XElement(TypesNs + "Override", New XAttribute("PartName", "/xl/workbook.xml"), New XAttribute("ContentType", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml")),
                New XElement(TypesNs + "Override", New XAttribute("PartName", "/xl/styles.xml"), New XAttribute("ContentType", "application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml")))
            For i As Integer = 1 To count
                root.Add(New XElement(TypesNs + "Override", New XAttribute("PartName", "/xl/worksheets/sheet" & i.ToString() & ".xml"), New XAttribute("ContentType", "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml")))
            Next
            Return New XDocument(New XDeclaration("1.0", "utf-8", "yes"), root)
        End Function

