            Add(overview, "Destination container", destination)
            Add(overview, "New reporting root", newRoot)
            Add(overview, "Export version", Attr(source.Root, "version"))
            Add(overview, "Generated at", DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture))
            Add(overview, "Corresponding clone file", cloneFileName)
            Add(overview, "New reporting members", package.NewNames.Count)
            Dim allTargetEdges = targetDims.SelectMany(Function(d) d.Element("relationships").Elements("relationship")).ToList()
            Dim reused As New HashSet(Of String)(allTargetEdges.Where(Function(e) targetNames.Contains(Attr(e, "parent")) AndAlso
                Not targetNames.Contains(Attr(e, "child"))).Select(Function(e) Attr(e, "child")), CI)
            Add(overview, "Distinct reused detail accounts", reused.Count)
            Add(overview, "Review items", package.ReviewIssues.Count)
            Add(overview, "Metadata applied by the generator", "None. It writes files and log entries only.")
            Add(overview, "Workbook use", "Review only. This XLSX is not a OneStream metadata import file or the Marketplace Metadata Builder template.")
            Add(overview, "Stored data", "Not copied to the new reporting member IDs.")
            Add(overview, "Formula references", "Preserved as exported. Review references to original members.")
            Add(overview, "Aliases", "Original aliases are cleared on new members; both values appear in Properties.")
            Add(overview, "Existing dimension settings", "Copied from the source snapshot into the XML dimension wrappers. Check for later changes before import.")
            Add(overview, "Destination relationship", "The new root appears wherever the destination container is shared or inherited.")
            Add(overview, "Source snapshot", "01_Source_Account_Metadata.xml contains all exported Account metadata.")
            Add(overview, "RootAccountDim export", If(sourceDims.Any(Function(d) CI.Equals(Attr(d, "name"), "RootAccountDim")),
                "Present", "Omitted by the export; the four business dimensions are still validated."))
            For Each dimName As String In chain.Skip(1)
                Dim d As XElement = targetDims.FirstOrDefault(Function(x) CI.Equals(Attr(x, "name"), dimName))
                Dim membersCount As Integer = If(d Is Nothing, 0, d.Element("members").Elements("member").Count())
                Dim localEdges As List(Of XElement) = If(d Is Nothing, New List(Of XElement), d.Element("relationships").Elements("relationship").ToList())
                Dim attachmentCount As Integer = localEdges.Where(Function(e) CI.Equals(Attr(e, "parent"), destination) AndAlso CI.Equals(Attr(e, "child"), newRoot)).Count()
                Add(overview, dimName & " - new members", membersCount)
                Add(overview, dimName & " - copied internal relationships", localEdges.Count - attachmentCount)
                Add(overview, dimName & " - new destination attachments", attachmentCount)
                Add(overview, dimName & " - distinct reused detail accounts", localEdges.Where(Function(e) targetNames.Contains(Attr(e, "parent")) AndAlso
                    Not targetNames.Contains(Attr(e, "child"))).Select(Function(e) Attr(e, "child")).Distinct(CI).Count())
            Next
            sheets.Add(overview)

            Dim hierarchy = MakeSheet("Hierarchy", "Proposed reporting hierarchy",
