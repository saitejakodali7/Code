                New Object() {"Level", "Source member", "Proposed hierarchy (indented)", "Source parent", "Proposed parent", "Member action", "Relationship dimension", "Weight", "Review item IDs"},
                New Double() {9, 32, 53, 32, 36, 22, 28, 16, 20})
            Dim rootAttachment As XElement = allTargetEdges.FirstOrDefault(Function(e) CI.Equals(Attr(e, "parent"), destination) AndAlso CI.Equals(Attr(e, "child"), newRoot))
            Add(hierarchy, 0, sourceRoot, newRoot, "", If(rootAttachment Is Nothing, "Attachment not emitted", destination),
                "New root", sourceOwners(sourceRoot), If(rootAttachment Is Nothing, "Not emitted", Weight(rootAttachment)), issueRefs(sourceRoot))
            AddChildren(hierarchy, sourceRoot, newRoot, 1, children, edgeOwners, package.SourceToTarget, issueRefs)
            sheets.Add(hierarchy)

            Dim memberSheet = MakeSheet("Members", "New reporting member definitions",
                "Only new member definitions are listed. Full descriptions, aliases and varying properties are shown in Properties.",
                New Object() {"Source member", "New member", "Owning dimension", "Description preview", "Account type", "Formula type", "Allow input", "Is consolidated", "Original aliases", "New aliases", "Review item IDs"},
                New Double() {32, 36, 28, 60, 18, 22, 18, 22, 36, 22, 20})
            Dim props = MakeSheet("Properties", "Original and proposed member settings",
