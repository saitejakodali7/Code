            Dim packageEdges As New Dictionary(Of String, List(Of PreviewEdge))(CI)
            For i As Integer = 0 To chain.Length - 1
                AddDimensionEdges(sourceDims, chain(i), original)
                AddDimensionEdges(sourceDims, chain(i), proposed)
                AddDimensionEdges(packageDims, chain(i), proposed)
