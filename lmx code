        Private Shared Sub Put(ByVal zip As System.IO.Compression.ZipArchive, ByVal name As String, ByVal document As XDocument)
            Dim entry As System.IO.Compression.ZipArchiveEntry = zip.CreateEntry(name, System.IO.Compression.CompressionLevel.Optimal)
            Using stream As Stream = entry.Open()
                Using writer As New StreamWriter(stream, New UTF8Encoding(False))
                    document.Save(writer, SaveOptions.DisableFormatting)
                End Using
            End Using
        End Sub
