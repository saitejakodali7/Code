t-size:10px;line-height:17px;padding:0 6px;border-radius:9px;margin-left:7px;vertical-align:1px;white-space:nowrap;font-weight:bold;text-transform:uppercase}.new{background:#e6eef9;color:#244f87}.reuse{background:#e5f1e9;color:#2d6843}.existing{background:#eef0f3;color:#5b6470}.node-meta{margin:1px 0 4px 17px}.description{font-size:12px;color:#566575;margin-bottom:2px}.weight{font-size:11px;color:#586471;white-space:nowrap;margin-left:8px}.warning{background:#fff1d7;border:1px solid #e0bd77;color:#674900;border-radius:4px;padding:10px;margin:8px 0;overflow-wrap:anywhere}.status{font-size:12px;color:#5c6875;padding:10px 18px;border-top:1px solid #e1e6eb}.review summary{cursor:pointer;font-weight:bold}.review ul{margin-bottom:0;padding-left:22px}.review li{margin:7px 0;overflow-wrap:anywhere}.legend{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0 0}.legend .badge{margin-left:0}.empty{padding:12px;color:#596675}footer{color:#66717e;font-size:12px;margin-top:18px}@media(max-width:900px){main{padding:16px}.panes{grid-template-columns:1fr}.tree{max-height:65vh}h1{font-size:24px}}@media print{body{background:white}main{padding:0}.tree{max-height:none;overflow:visible}.panes{grid-template-columns:1fr}.tabs{display:none}.pane{break-inside:avoid}}")
            For i As Integer = 1 To chain.Length - 1
