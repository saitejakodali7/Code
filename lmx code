        Private Shared Sub AppendPane(ByVal html As StringBuilder, ByVal heading As String,
            ByVal caption As String, ByVal root As String,
            ByVal graph As Dictionary(Of String, List(Of PreviewEdge)),
            ByVal members As Dictionary(Of String, PreviewMember),
            ByVal reverseMap As Dictionary(Of String, String), ByVal isProposed As Boolean)
            html.AppendLine("<article class='pane'><header class='pane-head'><h2>" & H(heading) & "</h2><div class='meta'>" & H(caption) & "</div></header>")
            AppendTree(html, root, graph, members, reverseMap, isProposed)
            html.AppendLine("</article>")
        End Sub

        Private Shared Sub AppendTree(ByVal html As StringBuilder, ByVal root As String,
            ByVal graph As Dictionary(Of String, List(Of PreviewEdge)),
            ByVal members As Dictionary(Of String, PreviewMember),
            ByVal reverseMap As Dictionary(Of String, String), ByVal isProposed As Boolean)
            Dim state As New RenderState
            html.AppendLine("<div class='tree'><ul class='branch'>")
            AppendNode(html, root, Nothing, graph, members, reverseMap, isProposed, state, 0)
            html.AppendLine("</ul></div>")
            If state.Incomplete Then
                html.AppendLine("<div class='warning'>INCOMPLETE PREVIEW: at least one branch was stopped by a cycle, depth limit, or path limit. Use the native XML for the complete metadata graph.</div>")
            End If
            html.AppendLine("<div class='status'>" & state.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) & " account occurrences shown. Repeated shared paths are retained; counts are not distinct member counts.</div>")
        End Sub

        Private Shared Sub AppendNode(ByVal html As StringBuilder, ByVal name As String,
            ByVal incoming As PreviewEdge, ByVal graph As Dictionary(Of String, List(Of PreviewEdge)),
            ByVal members As Dictionary(Of String, PreviewMember), ByVal reverseMap As Dictionary(Of String, String),
            ByVal isProposed As Boolean, ByVal state As RenderState, ByVal depth As Integer)
            If state.Count >= MaxPathsPerPane OrElse depth > MaxDepth OrElse state.Path.Contains(name) Then
                state.Incomplete = True
                Dim reason As String = If(state.Path.Contains(name), "Cycle stopped", If(depth > MaxDepth, "Depth limit reached", "Path limit reached"))
                html.AppendLine("<li class='warning'>" & H(reason) & " before " & H(name) & "; this branch is incomplete.</li>")
                Return
            End If
            state.Count += 1
            state.Path.Add(name)
            Dim children As List(Of PreviewEdge) = Nothing
            Dim hasChildren As Boolean = graph.TryGetValue(name, children) AndAlso children.Count > 0
            html.Append("<li class='node'>")
            If hasChildren Then html.Append("<details" & If(depth <= 1, " open", "") & "><summary>") Else html.Append("<div class='leaf'>")
            html.Append("<span class='name'>" & H(name) & "</span>")
            If isProposed AndAlso reverseMap.ContainsKey(name) Then
                html.Append("<span class='badge new'>New member</span>")
            ElseIf isProposed AndAlso incoming IsNot Nothing Then
                html.Append("<span class='badge reuse'>Reused</span>")
            Else
                html.Append("<span class='badge existing'>Existing</span>")
            End If
            If incoming IsNot Nothing Then html.Append("<span class='weight'>Weight: " & H(incoming.Weight) & "</span>")
            html.AppendLine(If(hasChildren, "</summary>", "</div>"))
            html.Append("<div class='node-meta'>")
            Dim member As PreviewMember = Nothing
            If members.TryGetValue(name, member) Then
                If Not String.IsNullOrEmpty(member.Description) Then html.Append("<div class='description'>" & H(member.Description) & "</div>")
                html.Append("<div class='meta'>Member dimension: " & H(member.Owner) & "</div>")
            Else
                html.Append("<div class='meta'>Member definition not present in these files</div>")
            End If
            If reverseMap.ContainsKey(name) Then html.Append("<div class='meta'>Cloned from: " & H(reverseMap(name)) & "</div>")
            If incoming IsNot Nothing Then html.Append("<div class='meta'>Relationship dimension: " & H(incoming.Owner) & "</div>")
            html.AppendLine("</div>")
            If hasChildren Then
                html.AppendLine("<ul class='branch'>")
                For Each edge As PreviewEdge In children
                    If state.Count >= MaxPathsPerPane Then
                        state.Incomplete = True
                        html.AppendLine("<li class='warning'>Path limit reached; remaining child paths in this branch are omitted.</li>")
                        Exit For
                    End If
                    AppendNode(html, edge.Child, edge, graph, members, reverseMap, isProposed, state, depth + 1)
                Next
                html.AppendLine("</ul></details>")
            End If
            html.AppendLine("</li>")
            state.Path.Remove(name)
        End Sub

        Private Shared Function HasAttachment(ByVal graph As Dictionary(Of String, List(Of PreviewEdge)),
            ByVal parent As String, ByVal child As String) As Boolean
            Return graph.ContainsKey(parent) AndAlso graph(parent).Any(Function(e) CI.Equals(e.Child, child))
        End Function

        Private Shared Function DimensionIndex(ByVal doc As XDocument) As Dictionary(Of String, XElement)
            Dim result As New Dictionary(Of String, XElement)(CI)
            For Each node As XElement In doc.Descendants("dimension")
                If CI.Equals(CStr(node.Attribute("type")), "Account") Then result(CStr(node.Attribute("name"))) = node
            Next
            Return result
        End Function

        Private Shared Function MemberIndex(ByVal dims As Dictionary(Of String, XElement)) As Dictionary(Of String, PreviewMember)
            Dim result As New Dictionary(Of String, PreviewMember)(CI)
            For Each dimEntry As KeyValuePair(Of String, XElement) In dims
                Dim section As XElement = dimEntry.Value.Element("members")
                If section Is Nothing Then Continue For
                For Each node As XElement In section.Elements("member")
                    Dim info As New PreviewMember With {.Owner = dimEntry.Key, .Description = CStr(node.Attribute("description"))}
                    If String.IsNullOrEmpty(info.Description) Then
                        Dim descriptions As List(Of XElement) = node.Descendants("description").ToList()
                        Dim description As XElement = descriptions.FirstOrDefault(Function(d) CI.Equals(CStr(d.Attribute("culture")), "en-US"))
                        If description Is Nothing Then description = descriptions.FirstOrDefault()
                        If description IsNot Nothing Then info.Description = If(CStr(description.Attribute("value")), description.Value)
                    End If
                    result(CStr(node.Attribute("name"))) = info
                Next
            Next
            Return result
        End Function

        Private Shared Sub AddDimensionEdges(ByVal dims As Dictionary(Of String, XElement),
            ByVal dimName As String, ByVal graph As Dictionary(Of String, List(Of PreviewEdge)))
            If Not dims.ContainsKey(dimName) Then Return
            Dim section As XElement = dims(dimName).Element("relationships")
            If section Is Nothing Then Return
            For Each node As XElement In section.Elements("relationship")
                Dim parent As String = CStr(node.Attribute("parent"))
                Dim child As String = CStr(node.Attribute("child"))
                If String.IsNullOrEmpty(parent) OrElse String.IsNullOrEmpty(child) Then Continue For
                Dim weight As String = CStr(node.Attribute("aggregationWeight"))
                If String.IsNullOrEmpty(weight) Then weight = "not exported (no default assumed)"
                Dim varying As New List(Of String)
                For Each prop As XElement In node.Descendants("property")
                    If Not CI.Equals(CStr(prop.Attribute("name")), "Weight") AndAlso Not CI.Equals(CStr(prop.Attribute("name")), "AggregationWeight") Then Continue For
                    Dim qualifiers As String = String.Join(", ", prop.Attributes().Where(Function(a) a.Name.LocalName <> "name" AndAlso a.Name.LocalName <> "value").Select(Function(a) a.Name.LocalName & "=" & a.Value).ToArray())
                    varying.Add(If(CStr(prop.Attribute("value")), "") & If(qualifiers.Length = 0, "", " [" & qualifiers & "]"))
                Next
                If varying.Count > 0 Then weight &= "; varying: " & String.Join("; ", varying.ToArray())
                If Not graph.ContainsKey(parent) Then graph.Add(parent, New List(Of PreviewEdge))
                graph(parent).Add(New PreviewEdge With {.Child = child, .Owner = dimName, .Weight = weight})
            Next
        End Sub

        Private Shared Function H(ByVal value As String) As String
            Return System.Net.WebUtility.HtmlEncode(If(value, ""))
        End Function
    End Class
