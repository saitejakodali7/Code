Namespace OneStream.BusinessRule.Extender.BuildMMRptgClone
    ' Offline review only. Reads the snapshot/package and never changes either.
    Public NotInheritable Class HierarchyPreviewWriter
        Private Shared ReadOnly CI As StringComparer = StringComparer.OrdinalIgnoreCase
        Private Const MaxPathsPerPane As Integer = 10000
        Private Const MaxDepth As Integer = 250

        Private Class PreviewEdge
            Public Child As String
            Public Owner As String
            Public Weight As String
        End Class

        Private Class PreviewMember
            Public Owner As String
            Public Description As String
        End Class

        Private Class RenderState
            Public Count As Integer
            Public Incomplete As Boolean
            Public Path As New HashSet(Of String)(CI)
        End Class

        Public Shared Sub Save(ByVal path As String, ByVal source As XDocument,
            ByVal package As ClonePackage, ByVal chain As String(),
            ByVal sourceRoot As String, ByVal destination As String, ByVal newRoot As String)

            If source Is Nothing Then Throw New ArgumentNullException("source")
            If package Is Nothing OrElse package.Document Is Nothing Then Throw New ArgumentNullException("package")
            If chain Is Nothing OrElse chain.Length < 2 Then Throw New ArgumentException("Configure the dimension chain.", "chain")
            Dim sourceDims As Dictionary(Of String, XElement) = DimensionIndex(source)
            Dim packageDims As Dictionary(Of String, XElement) = DimensionIndex(package.Document)
            Dim members As Dictionary(Of String, PreviewMember) = MemberIndex(sourceDims)
            For Each item As KeyValuePair(Of String, PreviewMember) In MemberIndex(packageDims)
                members(item.Key) = item.Value
            Next
            Dim reverseMap As New Dictionary(Of String, String)(CI)
            For Each item As KeyValuePair(Of String, String) In package.SourceToTarget
                reverseMap(item.Value) = item.Key
            Next

            Dim html As New StringBuilder
            html.AppendLine("<!doctype html><html lang='en'><head><meta charset='utf-8'>")
            html.AppendLine("<meta name='viewport' content='width=device-width,initial-scale=1'>")
            html.AppendLine("<meta http-equiv='Content-Security-Policy' content=""default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"">")
            html.AppendLine("<title>Initial hierarchy clone preview</title><style>")
            html.AppendLine(".report-text{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.5 Arial,sans-serif;max-height:360px;overflow:auto;background:#f8fafc;padding:12px}.review-state{font-weight:bold;margin-top:14px}")
            html.AppendLine(".node-meta{display:none}#show-details:checked~.selector .node-meta{display:block}.detail-label{display:inline-block;margin:0 0 16px 6px}.badge{font-size:11px!important}")
