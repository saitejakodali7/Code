                New Double() {28, 32, 32, 36, 36, 22, 18, 18, 22, 60, 28})
            For Each dimNode As XElement In targetDims
                Dim ordinal As New Dictionary(Of String, Integer)(CI)
                For Each edge As XElement In dimNode.Element("relationships").Elements("relationship")
                    Dim p As String = Attr(edge, "parent"), c As String = Attr(edge, "child")
                    If Not ordinal.ContainsKey(p) Then ordinal.Add(p, 0)
                    ordinal(p) += 1
                    Dim attachment As Boolean = CI.Equals(p, destination) AndAlso CI.Equals(c, newRoot)
                    Dim oldParent As String = If(attachment, "", inverse(p))
                    Dim oldChild As String = If(attachment, "", If(inverse.ContainsKey(c), inverse(c), c))
                    Dim oldEdge As XElement = Nothing
                    If Not attachment Then oldEdge = sourceEdges(Key(Attr(dimNode, "name"), oldParent, oldChild))
                    Dim attributes As String = String.Join("; ", edge.Attributes().Where(Function(a) Not {"parent", "child", "aggregationWeight"}.
                        Contains(a.Name.LocalName, CI)).Select(Function(a) a.ToString()).ToArray())
                    Add(relationships, Attr(dimNode, "name"), oldParent, oldChild, p, c,
